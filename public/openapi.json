{
  "openapi": "3.0.3",
  "info": {
    "title": "Mezun Takip Sistemi (Alumni) API",
    "description": "Mezun Takip Sistemi API ve Web Controller dokümantasyonu. /users (UserController) ve /api/users (ApiUserController) uç noktalarını, parametrelerini ve CRUD işlevlerini içerir.",
    "version": "1.1.0",
    "contact": {
      "name": "Gamze Şüeda Akpınar",
      "email": "gamzesuedaakpinar@gmail.com"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "Mevcut Sunucu"
    }
  ],
  "tags": [
    {
      "name": "Sistem Sağlığı",
      "description": "API ve veritabanı durum kontrolleri"
    },
    {
      "name": "REST API (/api/users - ApiUserController)",
      "description": "JSON tabanlı RESTful API CRUD işlemleri (ApiUserController tarafından yönetilir)"
    },
    {
      "name": "Web Controller (/users - UserController)",
      "description": "Web & Resource tabanlı kullanıcı CRUD işlemleri (UserController tarafından yönetilir)"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["Sistem Sağlığı"],
        "summary": "Sistem ve Veritabanı Sağlık Durumu",
        "description": "API servisinin çalışıp çalışmadığını ve MySQL veritabanı bağlantısının durumunu kontrol eder.",
        "operationId": "getHealthStatus",
        "responses": {
          "200": {
            "description": "Sistem ve veritabanı sağlıklı",
            "content": {
              "application/json": {
                "example": {
                  "status": "ok",
                  "timestamp": "2026-10-07T13:00:00+03:00",
                  "app_name": "Alumni Tracking System",
                  "environment": "local",
                  "database": {
                    "connection": "mysql",
                    "status": "connected",
                    "database_name": "alumni"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["REST API (/api/users - ApiUserController)"],
        "summary": "Tüm Mezun Kullanıcıları Listele (JSON)",
        "description": "ApiUserController@index metodunu çağırarak tüm mezun kullanıcıları JSON formatında listeler.",
        "operationId": "apiListUsers",
        "responses": {
          "200": {
            "description": "Kullanıcılar başarıyla listelendi",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "Users listed successfully",
                  "total": 5,
                  "data": [
                    {
                      "id": 1,
                      "name": "Gamze Şüeda Akpınar",
                      "email": "gamze@example.com",
                      "student_number": "2019123456",
                      "graduation_year": 2024,
                      "department": "Bilgisayar Mühendisliği",
                      "current_company": "Google",
                      "current_position": "Software Engineer",
                      "city": "İstanbul",
                      "status": "approved",
                      "created_at": "2026-09-30T06:00:00+00:00"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["REST API (/api/users - ApiUserController)"],
        "summary": "Yeni Mezun Kullanıcı Oluştur (JSON)",
        "description": "ApiUserController@store metodunu çağırarak yeni bir kullanıcı oluşturur ve 201 Created döner.",
        "operationId": "apiCreateUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              },
              "example": {
                "name": "Mehmet Demir",
                "email": "mehmet.demir@example.com",
                "student_number": "202011022",
                "graduation_year": 2024,
                "department": "Yazılım Mühendisliği",
                "current_company": "Microsoft",
                "current_position": "Cloud Engineer",
                "city": "Ankara"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Kullanıcı başarıyla oluşturuldu",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "User created and saved successfully",
                  "data": {
                    "id": 6,
                    "name": "Mehmet Demir",
                    "email": "mehmet.demir@example.com",
                    "status": "approved"
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validasyon hatası"
          }
        }
      }
    },
    "/api/users/{id}": {
      "get": {
        "tags": ["REST API (/api/users - ApiUserController)"],
        "summary": "ID ile Tekil Kullanıcı Detayı (JSON)",
        "description": "ApiUserController@show metodu ile belirtilen ID'deki kullanıcının detaylarını getirir.",
        "operationId": "apiGetUserById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Kullanıcı ID numarası",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Kullanıcı bulundu",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "data": {
                    "id": 1,
                    "name": "Gamze Şüeda Akpınar",
                    "email": "gamze@example.com",
                    "current_company": "Google"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Kullanıcı bulunamadı"
          }
        }
      },
      "put": {
        "tags": ["REST API (/api/users - ApiUserController)"],
        "summary": "Kullanıcı Tam Güncelleme (PUT)",
        "description": "ApiUserController@update metodu ile kullanıcının tüm bilgilerini günceller.",
        "operationId": "apiUpdateUserPut",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Güncellenecek kullanıcı ID",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequest"
              },
              "example": {
                "name": "Gamze Şüeda Akpınar",
                "email": "gamze@alumni.com",
                "current_company": "Google",
                "current_position": "Staff Engineer"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kullanıcı başarıyla güncellendi"
          },
          "404": {
            "description": "Kullanıcı bulunamadı"
          }
        }
      },
      "patch": {
        "tags": ["REST API (/api/users - ApiUserController)"],
        "summary": "Kullanıcı Kısmi Güncelleme (PATCH)",
        "description": "ApiUserController@update metodu ile sadece gönderilen alanları günceller.",
        "operationId": "apiUpdateUserPatch",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequest"
              },
              "example": {
                "current_position": "Lead AI Engineer"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kullanıcı kısmi olarak güncellendi"
          },
          "404": {
            "description": "Kullanıcı bulunamadı"
          }
        }
      },
      "delete": {
        "tags": ["REST API (/api/users - ApiUserController)"],
        "summary": "Kullanıcı Silme (DELETE)",
        "description": "ApiUserController@destroy metodu ile kullanıcıyı sistemden siler.",
        "operationId": "apiDeleteUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 4
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Kullanıcı silindi",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "User with ID 4 deleted successfully"
                }
              }
            }
          },
          "404": {
            "description": "Kullanıcı bulunamadı"
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["Web Controller (/users - UserController)"],
        "summary": "Web Kullanıcı Listesi (UserController@index)",
        "description": "UserController@index metodunu çağırır. Blade görünümü (users.index) varsa sayfayı render eder, yoksa JSON listesi döner.",
        "operationId": "webListUsers",
        "responses": {
          "200": {
            "description": "Kullanıcı listesi başarıyla getirildi",
            "content": {
              "application/json": {
                "example": {
                  "status": "success",
                  "message": "Users retrieved via UserController@index",
                  "total": 5,
                  "data": []
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Web Controller (/users - UserController)"],
        "summary": "Web Kullanıcı Kaydı (UserController@store)",
        "description": "UserController@store metodu üzerinden yeni kullanıcı kaydeder.",
        "operationId": "webStoreUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              },
              "example": {
                "name": "Zeynep Arslan",
                "email": "zeynep@example.com",
                "student_number": "20210044",
                "department": "Endüstri Mühendisliği",
                "city": "Bursa"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Kullanıcı başarıyla kaydedildi"
          },
          "422": {
            "description": "Validasyon hatası"
          }
        }
      }
    },
    "/users/create": {
      "get": {
        "tags": ["Web Controller (/users - UserController)"],
        "summary": "Yeni Kullanıcı Ekleme Formu (UserController@create)",
        "description": "UserController@create metodunu çağırarak users.create Blade form görünümünü veya durum bilgisini döner.",
        "operationId": "webCreateUserForm",
        "responses": {
          "200": {
            "description": "Form sayfası hazır"
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": ["Web Controller (/users - UserController)"],
        "summary": "Web Kullanıcı Detayı (UserController@show)",
        "description": "UserController@show metodu ile tekil kullanıcı detayını döner.",
        "operationId": "webShowUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Kullanıcı bulundu"
          },
          "404": {
            "description": "Kullanıcı bulunamadı"
          }
        }
      },
      "put": {
        "tags": ["Web Controller (/users - UserController)"],
        "summary": "Web Kullanıcı Güncelleme (UserController@update)",
        "description": "UserController@update metodu üzerinden kullanıcıyı günceller.",
        "operationId": "webUpdateUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Kullanıcı güncellendi"
          },
          "404": {
            "description": "Kullanıcı bulunamadı"
          }
        }
      },
      "delete": {
        "tags": ["Web Controller (/users - UserController)"],
        "summary": "Web Kullanıcı Silme (UserController@destroy)",
        "description": "UserController@destroy metodu ile kullanıcıyı siler.",
        "operationId": "webDestroyUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Kullanıcı silindi"
          },
          "404": {
            "description": "Kullanıcı bulunamadı"
          }
        }
      }
    },
    "/users/{id}/edit": {
      "get": {
        "tags": ["Web Controller (/users - UserController)"],
        "summary": "Kullanıcı Düzenleme Formu (UserController@edit)",
        "description": "UserController@edit metodunu çağırarak users.edit Blade form görünümünü veya düzenleme verisini döner.",
        "operationId": "webEditUserForm",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Düzenleme formu hazır"
          },
          "404": {
            "description": "Kullanıcı bulunamadı"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateUserRequest": {
        "type": "object",
        "required": ["name", "email"],
        "properties": {
          "name": {
            "type": "string",
            "example": "Mehmet Demir"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "mehmet.demir@example.com"
          },
          "student_number": {
            "type": "string",
            "example": "202011022"
          },
          "graduation_year": {
            "type": "integer",
            "example": 2024
          },
          "department": {
            "type": "string",
            "example": "Yazılım Mühendisliği"
          },
          "current_company": {
            "type": "string",
            "example": "Microsoft"
          },
          "current_position": {
            "type": "string",
            "example": "Cloud Engineer"
          },
          "city": {
            "type": "string",
            "example": "Ankara"
          }
        }
      },
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "student_number": {
            "type": "string"
          },
          "graduation_year": {
            "type": "integer"
          },
          "department": {
            "type": "string"
          },
          "current_company": {
            "type": "string"
          },
          "current_position": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "approved", "rejected"]
          }
        }
      }
    }
  }
}
